{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://apis.google.com https://accounts.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https: http:; media-src 'self' data: blob: https: http:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://mansara-backend.onrender.com https://api.mansarafoods.com https://accounts.google.com; frame-src https://accounts.google.com; object-src 'none'; base-uri 'self'; form-action 'self';"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "mansarafoods.com"
        }
      ],
      "destination": "https://www.mansarafoods.com/:path*",
      "permanent": true
    },
    { "source": "/product/curry-leaves-rice-podi-mix", "destination": "/product/karuveppillai-special", "permanent": true },
    { "source": "/product/curry-leaf-podi-mix", "destination": "/product/karuveppillai-special", "permanent": true },
    { "source": "/product/coriander-rice-podi-mix", "destination": "/product/kotha-malli-aroma", "permanent": true },
    { "source": "/product/coriander-podi-mix", "destination": "/product/kotha-malli-aroma", "permanent": true },
    { "source": "/product/moringa-rice-podi-mix", "destination": "/product/murungai-vital", "permanent": true },
    { "source": "/product/moringa-podi-mix", "destination": "/product/murungai-vital", "permanent": true },
    { "source": "/product/pirandai-rice-podi-mix", "destination": "/product/pirandai-power", "permanent": true },
    { "source": "/product/pirandai-podi-mix", "destination": "/product/pirandai-power", "permanent": true },
    { "source": "/product/rice-podi-mix", "destination": "/product/home-style-paruppu-podi", "permanent": true },
    { "source": "/product/urad-porridge-mix-classic-250g", "destination": "/product/urad-porridge-mix-classic", "permanent": true },
    { "source": "/product/urad-porridge-mix-salt-pepper-250g", "destination": "/product/urad-porridge-mix-salt-pepper", "permanent": true },
    { "source": "/product/urad-porridge-mix-millet-magic-250g", "destination": "/product/urad-porridge-mix-millet-magic", "permanent": true },
    { "source": "/product/urad-porridge-mix-premium-250g", "destination": "/product/urad-porridge-mix-premium", "permanent": true },
    { "source": "/product/black-rice-delight-porridge-mix-250g", "destination": "/product/black-rice-delight-porridge-mix", "permanent": true }
  ],
  "rewrites": [
    { "source": "/cart", "destination": "/index.html" },
    { "source": "/checkout", "destination": "/index.html" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/register", "destination": "/index.html" },
    { "source": "/verify-email", "destination": "/index.html" },
    { "source": "/forgot-password", "destination": "/index.html" },
    { "source": "/account", "destination": "/index.html" },
    { "source": "/orders", "destination": "/index.html" },
    { "source": "/order-tracking/:path*", "destination": "/index.html" },
    { "source": "/admin/:path*", "destination": "/index.html" }
  ]
}